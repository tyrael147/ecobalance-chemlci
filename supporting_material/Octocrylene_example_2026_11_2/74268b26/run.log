{'event': '[CALLBACK] Original args: {\'file\': \'{\\n  "name": "Octocrylene production, EUR",\\n  "comment": "Complete 7-step synthesis route for Octocrylene (2-ethylhexyl 2-cyano-3,3-diphenylprop-2-enoate), a UV filter for cosmetics. Normalized to 1 kg Octocrylene reference product. Location set to EUR per specification.",\\n  "source": "BW2LCIbuilder_agent",\\n  "nodes": [\\n    {\\n      "id": "d6fb93b2-a9cc-4f4f-a23b-7aa8f5d765f5",\\n      "name": "Octocrylene production",\\n      "unit": "kg",\\n      "type": {\\n        "name": "process"\\n      },\\n      "location": {\\n        "code": "EUR"\\n      },\\n      "code": "foreground_fallback",\\n      "database": "default_database",\\n      "source": "BW2LCIbuilder_agent",\\n      "product_information": "2-Ethylhexyl 2-cyano-3,3-diphenylprop-2-enoate. UV filter for cosmetics and sunscreens.",\\n      "comment": "Transesterification of Etocrylene with 2-ethylhexanol. Acid-catalyzed at 60-120°C under atmospheric to slightly elevated pressure. Catalyst: TiCl4, SnCl2, or p-toluenesulfonic acid (0.1-1 wt%). Solvent: Toluene/Xylene. Reaction time: 2-8 hours. Ethanol removal via distillation under reduced pressure.",\\n      "reference_flow": {\\n        "id": "ac53d8f2-2014-4784-b1f9-5359511ed6b3",\\n        "name": "Octocrylene",\\n        "unit": "kg",\\n        "type": "production",\\n        "amount": 1.0,\\n        "flow_object": {\\n          "name": "Octocrylene"\\n        },\\n        "from_activity": "d6fb93b2-a9cc-4f4f-a23b-7aa8f5d765f5",\\n        "to_activity": "d6fb93b2-a9cc-4f4f-a23b-7aa8f5d765f5",\\n        "source": "BW2LCIbuilder_agent"\\n      },\\n      "exchanges": [\\n        {\\n          "id": "7cfad0ac-7c60-4b5b-91a7-f94301324de9",\\n          "name": "Etocrylene",\\n          "unit": "kg",\\n          "type": "technosphere",\\n          "amount": 0.767,\\n          "comment": "Molar ratio 1:1 normalized to 1 kg Octocrylene (C24H27NO2, MW 361.5). Etocrylene MW 277.3: 277.3/361.5 = 0.767 kg",\\n          "flow_object": {\\n            "name": "Etocrylene"\\n          },\\n          "from_activity": "16c2e6be-38ea-41b2-a989-003785e541ed",\\n          "to_activity": "d6fb93b2-a9cc-4f4f-a23b-7aa8f5d765f5",\\n          "source": "BW2LCIbuilder_agent"\\n        },\\n        {\\n          "id": "d3a31e88-a09a-4ae8-a5d6-e49c403bd6bf",\\n          "name": "2-Ethylhexanol",\\n          "unit": "kg",\\n          "type": "technosphere",\\n          "amount": 0.36,\\n          "comment": "Molar ratio 1:1 normalized. 2-Ethylhexanol MW 130.23: 130.23/361.5 = 0.360 kg",\\n          "flow_object": {\\n            "name": "2-Ethylhexanol"\\n          },\\n          "from_activity": "686ed7fe-e7d9-4e0b-a34f-78903e452b83",\\n          "to_activity": "d6fb93b2-a9cc-4f4f-a23b-7aa8f5d765f5",\\n          "source": "BW2LCIbuilder_agent"\\n        },\\n        {\\n          "id": "752d7392-0427-44fe-a381-61e286d96d26",\\n          "name": "Ethanol",\\n          "unit": "kg",\\n          "type": "technosphere",\\n          "amount": -0.127,\\n          "comment": "By-product credit from transesterification. System expansion: 1 mol ethanol (MW 46.04) per 1 mol Octocrylene = -0.127 kg. Negative amount represents avoided production.",\\n          "flow_object": {\\n            "name": "Ethanol"\\n          },\\n          "from_activity": "ca534c84-6dbd-442c-b6c7-5e5ed7157010",\\n          "to_activity": "d6fb93b2-a9cc-4f4f-a23b-7aa8f5d765f5",\\n          "source": "BW2LCIbuilder_agent"\\n        },\\n        {\\n          "id": "89b610e0-5536-4498-948a-e146833cb3cf",\\n          "name": "Titanium tetrachloride",\\n          "unit": "kg",\\n          "type": "technosphere",\\n          "amount": 0.005,\\n          "comment": "Acid catalyst at 0.5 wt% of product mass",\\n          "flow_object": {\\n            "name": "Titanium tetrachloride"\\n          },\\n          "from_activity": "be27b902-54e2-4ed7-a76c-1b71256c5b50",\\n          "to_activity": "d6fb93b2-a9cc-4f4f-a23b-7aa8f5d765f5",\\n          "source": "BW2LCIbuilder_agent"\\n        },\\n        {\\n          "id": "f7f6d6cd-0a27-42df-8981-b0b983eb8ff6",\\n          "name": "Toluene",\\n          "unit": "kg",\\n          "type": "technosphere",\\n          "amount": 0.3,\\n          "comment": "Solvent carrier, assumed 30% of product mass. Recovered via distillation.",\\n          "flow_object": {\\n            "name": "Toluene"\\n          },\\n          "from_activity": "492a10e6-42c2-4dd1-8928-e4334b3cb87f",\\n          "to_activity": "d6fb93b2-a9cc-4f4f-a23b-7aa8f5d765f5",\\n          "source": "BW2LCIbuilder_agent"\\n        },\\n        {\\n          "id": "cb687756-6a63-4a36-b73a-ef9df52597f6",\\n          "name": "Electricity, medium voltage",\\n          "unit": "kWh",\\n          "type": "technosphere",\\n          "amount": 0.8,\\n          "comment": "Stirring, heating, distillation columns. Estimated 0.8 kWh per kg product for batch process.",\\n          "flow_object": {\\n            "name": "Electricity, medium voltage"\\n          },\\n          "from_activity": "02bf65ed-b1de-4843-ac49-ba1a643fba63",\\n          "to_activity": "d6fb93b2-a9cc-4f4f-a23b-7aa8f5d765f5",\\n          "source": "BW2LCIbuilder_agent"\\n        },\\n        {\\n          "id": "e3a17e89-753e-4c4c-931e-30f0d3d6bfaa",\\n          "name": "Heat, process",\\n          "unit": "MJ",\\n          "type": "technosphere",\\n          "amount": 2.5,\\n          "comment": "Heating to 60-120°C and distillation. Estimated 2.5 MJ per kg (exothermic transesterification partially offsets heating demand).",\\n          "flow_object": {\\n            "name": "Heat, process"\\n          },\\n          "from_activity": "84d71d50-d98a-47e0-805f-8790e540a4ce",\\n          "to_activity": "d6fb93b2-a9cc-4f4f-a23b-7aa8f5d765f5",\\n          "source": "BW2LCIbuilder_agent"\\n        },\\n        {\\n          "id": "266e7854-0de1-44f7-ae6a-256a32772085",\\n          "name": "Carbon dioxide",\\n          "unit": "kg