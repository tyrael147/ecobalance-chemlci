      "stirring": "Moderate mechanical stirring required for homogeneity"
    },
    
    "process_steps": {
      "step_1_preparation": "Dissolve ethyl cyanoacetate (1 equiv.) and benzophenone (1 equiv.) in ethanol",
      "step_2_catalyst_addition": "Add piperidine catalyst (5-15 mol%) dropwise to control ex …[truncated]"""^^xsd:string ;
