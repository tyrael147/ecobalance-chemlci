      "dcterms:title": "result:get_chemical_from_pubchem",
      "prov:value": "{\"name\": \"2-(1-Hydroxyethyl)hexanoic acid\", \"chemical_formula\": \"C8H16O3\", \"SMILES\": \"CCCCC(C(=O)O)C(C)O\", \"molecular_weight\": \"160.21\", \"inchi\": \"InChI=1S/C8H16O3/c1-3-4-5-7(6(2)9)8(10)11/h6-7,9H,3-5H2,1-2H3,(H,10,11)\", \"iupac_name\": \"2-(1-hydroxyethyl)hexanoic acid\", \"iri\": \"https://pubchem.ncbi.nlm.nih.gov/compound/80046637\", \"uncertainty_type\": 0, \"source\": \"get_chemical_from_pubchem\"}",
      "prov:wasDerivedFrom": {
