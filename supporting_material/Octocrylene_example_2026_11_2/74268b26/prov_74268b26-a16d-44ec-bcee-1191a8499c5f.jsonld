      "prov:value": "```json\n{\n  \"success\": \"Industrial Process for Etocrylene Synthesis via Knoevenagel Condensation\",\n  \"process_description\": {\n    \"reaction_type\": \"Knoevenagel Condensation (C-C Bond Formation)\",\n    \"overall_mechanism\": \"Condensation of ethyl cyanoacetate with benzophenone to form an α,β-unsaturated compound (Etocrylene), with water as the byproduct\",\n    \n    \"energy_requirements\": {\n      \"temperature_range\": \"Room temperature to 80°C\",\n      \"heating_profile\": \"Mild heating accelerates reaction; excessive heat may cause side reactions\",\n      \"energy_input\": \"Low to moderate; exothermic condensation reaction\"\n    },\n    \n    \"catalysts\": {\n      \"primary_options\": [\n        \"Organic bases: Piperidine, pyrrolidine, diethylamine (5-20 mol%)\",\n        \"Inorganic bases: Sodium acetate, potassium carbonate (stoichiometric)\",\n        \"Acidic catalysts: Acetic acid or formic acid (alternative pathway)\"\n      ],\n      \"preferred_industrial_catalyst\": \"Piperidine (most selective and efficient)\",\n      \"catalyst_loading\": \"5-15 mol% for optimal selectivity\"\n    },\n    \n    \"solvents\": {\n      \"primary_solvents\": [\n        \"Ethanol (preferred; miscible with both reactants)\",\n        \"Methanol (alternative)\",\n        \"Toluene or benzene (non-polar alternatives)\"\n      ],\n      \"solvent_volume\": \"Typically 5-10× mass of reactants for dilution\",\n      \"solvent_function\": \"Medium for reaction and water removal via azeotropic distillation\"\n    },\n    \n    \"process_conditions\": {\n      \"pressure\": \"Atmospheric (1 atm)\",\n      \"reaction_time\": \"2-24 hours depending on catalyst and temperature\",\n      \"reaction_medium_pH\": \"Slightly basic (pH 8-10) for optimal condensation\",\n      \"stirring\": \"Moderate mechanical stirring required for homogeneity\"\n    },\n    \n    \"process_steps\": {\n      \"step_1_preparation\": \"Dissolve ethyl cyanoacet