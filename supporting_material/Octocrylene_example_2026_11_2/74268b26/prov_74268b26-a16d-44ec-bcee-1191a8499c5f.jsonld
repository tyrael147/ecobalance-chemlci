      "prov:value": "```json\n{\n  \"products\": [\n    {\n      \"molecule\": {\n        \"chemical_formula\": {\n          \"method\": \"PubChem lookup\",\n          \"source\": \"pubchem\",\n          \"uncertainty_type\": 2,\n          \"value\": \"C10H20O3\"\n        },\n        \"inchi\": {\n          \"method\": \"PubChem lookup\",\n          \"source\": \"pubchem\",\n          \"uncertainty_type\": 2,\n          \"value\": \"InChI=1S/C10H20O3/c1-4-6-7-9(8(3)11)10(12)13-5-2/h8-9,11H,4-7H2,1-3H3\"\n        },\n        \"iupac_name\": {\n          \"method\": \"PubChem lookup\",\n          \"source\": \"pubchem\",\n          \"uncertainty_type\": 2,\n          \"value\": \"ethyl 2-(1-hydroxyethyl)hexanoate\"\n        },\n        \"molecular_weight\": {\n          \"method\": \"PubChem lookup\",\n          \"source\": \"pubchem\",\n          \"uncertainty_type\": 2,\n          \"unit\": \"g/mol\",\n          \"value\": 188.26\n        },\n        \"name\": \"Ethyl 2-(1-hydroxyethyl)hexanoate\",\n        \"physical_properties\": [],\n        \"smiles\": {\n          \"method\": \"RDKit\",\n          \"source\": \"EquationBalancer_agent\",\n          \"uncertainty_type\": 4,\n          \"value\": \"CCCCC(C(=O)OCC)C(C)O\"\n        },\n        \"source\": \"EquationBalancer_agent\",\n        \"uncertainty_type\": 4\n      },\n      \"source\": \"EquationBalancer_agent\",\n      \"stoichiometry\": 1,\n      \"uncertainty_type\": 4\n    }\n  ],\n  \"reactants\": [\n    {\n      \"molecule\": {\n        \"chemical_formula\": {\n          \"method\": \"PubChem lookup\",\n          \"source\": \"pubchem\",\n          \"uncertainty_type\": 2,\n          \"value\": \"C10H18O3\"\n        },\n        \"inchi\": {\n          \"method\": \"PubChem lookup\",\n          \"source\": \"pubchem\",\n          \"uncertainty_type\": 2,\n          \"value\": \"InChI=1S/C10H18O3/c1-4-6-7-9(8(3)11)10(12)13-5-2/h9H,4-7H2,1-3H3\"\n        },\n        \"iupac_name\": {\n          \"method\": \"PubChem lookup\",\n          \"source\": \"pubchem\",\n          \"uncertainty_type\": 2,\n          \"value\": \"ethyl 2-acetylhexanoate\"\n        },\n        \"molecular_weight\": {\n          \"method\": \"PubChem lookup\",\n          \"source\": \"pubchem\",\n          \"uncertainty_type\": 2,\n          \"unit\": \"g/mol\",\n          \"value\": 186.25\n        },\n        \"name\": \"Ethyl 2-acetylhexanoate\",\n        \"physical_properties\": [],\n        \"smiles\": {\n          \"method\": \"RDKit\",\n          \"source\": \"EquationBalancer_agent\",\n          \"uncertainty_type\": 4,\n          \"value\": \"CCCCC(C(C)=O)C(=O)OCC\"\n        },\n        \"source\": \"EquationBalancer_agent\",\n        \"uncertainty_type\": 4\n      },\n      \"source\": \"EquationBalancer_agent\",\n      \"stoichiometry\": 1,\n      \"uncertainty_type\": 4\n    },\n    {\n      \"molecule\": {\n        \"chemical_formula\": {\n          \"method\": \"PubChem lookup\",\n          \"source\": \"pubchem\",\n          \"uncertainty_type\": 2,\n          \"value\": \"H2\"\n        },\n        \"inchi\": {\n          \"method\": \"PubChem lookup\",\n          \"source\": \"pubchem\",\n          \"uncertainty_type\": 2,\n          \"value\": \"InChI=1S/H2/h1H\"\n        },\n        \"iupac_name\": {\n          \"method\": \"PubChem lookup\",\n          \"source\": \"pubchem\",\n          \"uncertainty_type\": 2,\n          \"value\": \"molecular hydrogen\"\n        },\n        \"molecular_weight\": {\n          \"method\": \"PubChem lookup\",\n          \"source\": \"pubchem\",\n          \"uncertainty_type\": 2,\n          \"unit\": \"g/mol\",\n          \"value\": 2.016\n        },\n        \"name\": \"Hydrogen\",\n        \"physical_properties\": [],\n        \"smiles\": {\n          \"method\": \"RDKit\",\n          \"source\": \"EquationBalancer_agent\",\n          \"uncertainty_type\": 4,\n          \"value\": \"[H][H]\"\n        },\n        \"source\": \"EquationBalancer_agent\",\n        \"uncertainty_type\": 4\n      },\n      \"source\": \"EquationBalancer_agent\",\n      \"stoichiometry\": 1,\n      \"uncertainty_type\": 4\n    }\n  ],\n  \"reaction_smiles\": \"CCCCC(C(C)=O)C(=O)OCC.[H][H]>>CCCCC(C(=O)OCC)C(C)O\",\n  \"source\": \"EquationBalancer_agent\",\n  \"uncertainty_type\": 4\n}\n```",
