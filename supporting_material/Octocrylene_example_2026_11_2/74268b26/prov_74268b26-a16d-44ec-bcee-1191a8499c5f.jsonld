    {
      "@id": "urn:adk-prov:runs/data/f30c088ac84c4aac8562eef7c7916a5f",
      "@type": "lcont:LLMResponse",
      "dcterms:title": "response:orchestrator_agent",
      "prov:value": "I need to reload the completed route and properly update only the process_description field while preserving all other structure:",
      "prov:wasDerivedFrom": {
        "@id": "urn:adk-prov:runs/prompt/orchestrator_agent_process_completion_3d7fd064e455faf7"
      },
