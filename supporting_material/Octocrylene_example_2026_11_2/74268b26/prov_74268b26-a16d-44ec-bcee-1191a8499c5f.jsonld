    {
      "@id": "urn:adk-prov:runs/data/d8a94ef7c77f4b5a8ff7ac6a246d0caf",
      "@type": "ssbd:Data",
      "dcterms:title": "args:save_json",
      "prov:value": "{\"name\": \"Octocrylene/74268b26/bw_inventory.json\", \"file\": \"[53486 chars omitted — see file output]\"}",
      "prov:wasDerivedFrom": {
        "@id": "urn:adk-prov:runs/data/13783cd45bf74a60aa2b8e739ff1ba35"
