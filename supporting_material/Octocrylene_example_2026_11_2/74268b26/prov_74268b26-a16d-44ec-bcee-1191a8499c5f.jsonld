      "prov:value": [
        "\"iri='lcont:Inventory_9201839bf3714200a68fde909f830d5a' source='InventoryDrafter_agent' uncertainty_type=5 name='Octocrylene production, GLO' comment='Complete 7-step synthesis route for Octocrylene (2-ethylhexyl 2-cyano-3,3-diphenylprop-2-enoate), a UV filter for cosmetics. Step 1: Knoevenagel condensation (ethyl cyanoacetate + benzophenone → Etocrylene). Step 2: Acetoacetic ester alkylation (ethyl acetoacetate + butyl bromide → ethyl 2-acetylhexanoate). Step 3: Selective ketone reduction (ethyl 2-acetylhexanoate + H2 → ethyl 2-(1-hydroxyethyl)hexanoate). Step 4: Ester hydrolysis (ethyl 2-(1-hydroxyethyl)hexanoate + H2O → 2-(1-hydroxyethyl)hexanoic acid). Step 5: Diol formation (2-(1-hydroxyethyl)hexanoic acid + CH4 → 2-butylbutane-1,3-diol). Step 6: Decarbonylation (2-butylbutane-1,3-diol + CO → 2-ethylhexanol + CO2). Step 7: Transesterification (Etocrylene + 2-ethylhexanol → Octocrylene + ethanol). Normalized to 1 kg Octocrylene reference product.' nodes=[LCIActivityNode(iri='oriont:Activity_Octocrylene%20production_d6fb93b2a9cc4f4fa23b7aa8f5d765f5', source='InventoryDrafter_agent', uncertainty_type=5, id=UUID('d6fb93b2-a9cc-4f4f-a23b-7aa8f5d765f5'), name='Octocrylene production', unit='kg', type=ActivityType(iri='oriont:ActivityType_32cebc15a17a40f6b4a6b3dbc85591ec', source=None, uncertainty_type=5, name='process'), code='default_code', location=Location(iri='oriont:Location_91edd32a456b42a7836a7adb6cadf803', source=None, uncertainty_type=5, code='GLO', name=None), database='default_database', synonyms=None, product_information='2-Ethylhexyl 2-cyano-3,3-diphenylprop-2-enoate. UV filter for cosmetics and sunscreens.', reference_flow=LCIExchange(iri='oriont:Flow_6773f94c7f054ec8b2bc88e2b6b13685', source='InventoryDrafter_agent', uncertainty_type=5, id=UUID('ac53d8f2-2014-4784-b1f9-5359511ed6b3'), name='Octocrylene', unit='kg', type='production', amount=1.0, comment='', from_activity=UUID('d6fb93b2-a9cc-4f4f-a23b-7aa8f5d765f5'), to_activity=UUID('d6fb93b2