rtainty_type\": 4}, {\"molecule\": {\"chemical_formula\": {\"method\": \"PubChem lookup\", \"source\": \"pubchem\", \"uncertainty_type\": 2, \"value\": \"H2\"}, \"inchi\": {\"method\": \"PubChem lookup\", \"source\": \"pubchem\", \"uncertainty_type\": 2, \"value\": \"InChI=1S/H2/h1H\"}, \"iupac_name\": {\"method\": \"PubChem lookup\", \"source\": \"pubchem\", \"uncertainty_type\": 2, \"value\": \"molecular hydrogen\"}, \"molecular_weight\": {\"method\": \"PubChem lookup\", \"source\": \"pubchem\", \"uncertainty_type\": 2, \"unit\": \"g/mol\", \"value\": 2.016}, \"name\": \"Hydrogen\", \"physical_properties\": [], \"smiles\": {\"method\": \"RDKit\", \"source\": \"EquationBalancer_agent\", \"uncertainty_type\": 4, \"value\": \"[H][H]\"}, \"source\": \"EquationBalancer_agent\", \"uncertainty_type\": 4}, \"source\": \"EquationBalancer_agent\", \"stoichiometry\": 1, \"uncertainty_type\": 4}], \"reaction_smiles\": \"CCCCC(C(C)=O)C(=O)OCC.[H][H]>>CCCCC(C(=O)OCC)C(C)O\", \"source\": \"EquationBalancer_agent\", \"uncertainty_type\": 4}",
